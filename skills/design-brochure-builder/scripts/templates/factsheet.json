    "stat2Value": { "type": "text" }, "stat2Label": { "type": "text" }, "stat2Desc": { "type": "text" },
    "stat3Value": { "type": "text" }, "stat3Label": { "type": "text" }, "stat3Desc": { "type": "text" },
    "section1Heading": { "type": "text" }, "section1Body": { "type": "text" },
    "section2Heading": { "type": "text" }, "section2Body": { "type": "text" },
    "section3Heading": { "type": "text" }, "section3Body": { "type": "text" },
    "section4Heading": { "type": "text" }, "section4Body": { "type": "text" },
    "inv1Title": { "type": "text" }, "inv1Subtitle": { "type": "text" }, "inv1Amount": { "type": "text" },
    "inv2Title": { "type": "text" }, "inv2Subtitle": { "type": "text" }, "inv2Amount": { "type": "text" },
    "inv3Title": { "type": "text" }, "inv3Subtitle": { "type": "text" }, "inv3Amount": { "type": "text" },
    "inv4Title": { "type": "text" }, "inv4Subtitle": { "type": "text" }, "inv4Amount": { "type": "text" },
    "benefit1": { "type": "text" }, "benefit1Icon": { "type": "text", "optional": true, "note": "Material Symbols icon name; defaults to a reasonable per-row pick (see templates/factsheet.js)" },
    "benefit2": { "type": "text" }, "benefit2Icon": { "type": "text", "optional": true },
    "benefit3": { "type": "text" }, "benefit3Icon": { "type": "text", "optional": true },
    "benefit4": { "type": "text" }, "benefit4Icon": { "type": "text", "optional": true }
