  "droppedProps": {
    "accentColor1": "declared in the source .dc.html's data-props (per-country flag-stripe accent colors) but never referenced by any rendered element in the 3 real pages — confirmed dead schema.",
    "accentColor2": "same as accentColor1.",
    "accentColor3": "same as accentColor1."
  }
