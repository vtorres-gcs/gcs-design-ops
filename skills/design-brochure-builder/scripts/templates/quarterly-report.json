{
  "name": "quarterly-report",
  "displayName": "Quarterly Report",
  "brand": "gcs",
  "sourceTemplate": "templates/brochures/quarterly-report/QuarterlyReport.dc.html",
  "implemented": true,
  "pageCount": 4,
  "pages": [
    "Cover",
    "About this Report + 5-article list (diagonal-stripe placeholder thumbnails)",
    "Content (heading + 3 sub-sections + CEO pull-quote with real photo)",
    "Global Presence (back cover)"
  ],
  "propsSchema": {
    "quarter": { "type": "text", "default": "Q2 2026" },
    "year": { "type": "text", "default": "2026" },
    "aboutPara1": { "type": "text" },
    "aboutPara2": { "type": "text" },
    "aboutPara3": { "type": "text" },
    "article1Title": { "type": "text" }, "article1Excerpt": { "type": "text" }, "article1Url": { "type": "text", "optional": true },
    "article2Title": { "type": "text" }, "article2Excerpt": { "type": "text" }, "article2Url": { "type": "text", "optional": true },
    "article3Title": { "type": "text" }, "article3Excerpt": { "type": "text" }, "article3Url": { "type": "text", "optional": true },
    "article4Title": { "type": "text" }, "article4Excerpt": { "type": "text" }, "article4Url": { "type": "text", "optional": true },
    "article5Title": { "type": "text" }, "article5Excerpt": { "type": "text" }, "article5Url": { "type": "text", "optional": true },
    "contentSectionLabel": { "type": "text", "default": "01 · Market Overview" },
    "contentHeading": { "type": "text", "default": "Key Regulatory & Policy Developments" },
    "section1Heading": { "type": "text" }, "section1Body": { "type": "text" },
    "section2Heading": { "type": "text" }, "section2Body": { "type": "text" },
    "section3Heading": { "type": "text" }, "section3Body": { "type": "text" },
    "pullQuote": { "type": "text" },
    "pullQuoteAuthor": { "type": "text" },
    "ceoPhotoPath": { "type": "path", "optional": true, "note": "absolute path to a real attribution photo; omit for the plain (no-photo) pull-quote variant" }
  },
  "droppedProps": {
    "coverSubtitle": "declared in the source .dc.html's data-props/renderVals but never rendered on the actual cover markup (page 1 only shows quarter + the two-line title) — confirmed dead schema, not a missing box.",
    "ctaHeading": "declared but no CTA page exists in this template's 4 real pages (Cover, About+Articles, Content, Back cover) despite the <!-- @template --> comment mentioning one.",
    "ctaPara1": "same as ctaHeading.",
    "ctaPara2": "same as ctaHeading.",
    "consultant1Name": "same as ctaHeading.",
    "consultant1Location": "same as ctaHeading.",
    "consultant2Name": "same as ctaHeading.",
    "consultant2Location": "same as ctaHeading.",
    "ctaEmail": "same as ctaHeading."
  }
}
